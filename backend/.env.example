# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Models
MODEL_MAIN=claude-sonnet-5-5
EFFORT=medium

# Agent limits (cost guardrails)
MAX_STEPS=12
MAX_RUN_COST_USD=0.50
MONTHLY_BUDGET_USD=10

# Approvals: tools at or above this tier wait for you to click Approve in the dashboard.
#   write = ask for write + destructive tools (default) | destructive = only destructive | never = auto-run everything
APPROVAL_LEVEL=write
# Seconds to wait for your answer before the action is denied
APPROVAL_TIMEOUT_S=300

# Server-side retry on a fallback model when a safety classifier declines (Claude API only)
REFUSAL_FALLBACK=true

# Web search is a paid server tool; disable to save cost
WEB_SEARCH_ENABLED=true

# Auth: when set, every /api request needs "Authorization: Bearer <token>". Leave empty only for local dev.
APP_TOKEN=

# Browser origins allowed to call the API directly (JSON list). The dashboard proxies /api, so this only
# matters if you call the backend from another origin. Default: localhost / 127.0.0.1 on ports 3000 and 3100.
# CORS_ORIGINS=["http://localhost:3100"]

# Demo mode: tools run against sandbox data only, stricter limits
DEMO_MODE=false
